{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/enum-default-objects.json",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        { "type": "string", "minLength": 1 },
        { "type": "integer" }
      ]
    },
    "with_default": {
      "type": "object",
      "default": { "properties": { "x": false }, "required": "not-a-keyword" }
    }
  }
}
